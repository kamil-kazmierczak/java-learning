{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kamil-kazmierczak/java-learning/schemas/language-policy.schema.json",
  "title": "language policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "The format version. A change needs a migration plan."
    },
    "record_type": {
      "const": "language-policy",
      "description": "The record type. The path selects the schema."
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "example",
        "live"
      ],
      "description": "Examples are fictional. Only live records can store learner state."
    },
    "standard": {
      "const": "ASD-STE100",
      "description": "The language standard."
    },
    "issue": {
      "const": 9,
      "description": "The standard issue."
    },
    "source_url": {
      "$ref": "common.schema.json#/$defs/url",
      "description": "The official reference."
    },
    "repository_language": {
      "const": "en",
      "description": "Write English prose."
    },
    "chat_language": {
      "const": "pl",
      "description": "Teach in Polish."
    },
    "review_language": {
      "const": "pl",
      "description": "Review in Polish."
    },
    "checker": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "The selected tool and version."
        },
        {
          "type": "null"
        }
      ],
      "description": "Null until a tool is selected."
    },
    "full_automated_compliance_claim": {
      "const": false,
      "description": "Partial checks do not prove full STE compliance."
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "code",
          "api_name",
          "identifier",
          "url",
          "exact_quote",
          "enum_value"
        ],
        "description": "An item that must keep its exact form."
      },
      "minItems": 0,
      "description": "Do not rewrite these items to satisfy prose rules.",
      "uniqueItems": true
    },
    "editorial_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^STYLE-[0-9]{2,}$",
            "description": "A project style rule ID."
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The writing rule."
          }
        },
        "required": [
          "rule_id",
          "instruction"
        ],
        "additionalProperties": false,
        "description": "One project rule."
      },
      "minItems": 1,
      "description": "Rules against filler and unsupported claims."
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The STE or project rule ID."
          },
          "origin": {
            "type": "string",
            "enum": [
              "ste",
              "project"
            ],
            "description": "The rule source."
          },
          "mode": {
            "type": "string",
            "enum": [
              "automatic",
              "manual",
              "not_implemented"
            ],
            "description": "The actual check method."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The declared check scope."
          }
        },
        "required": [
          "rule_id",
          "origin",
          "mode",
          "description"
        ],
        "additionalProperties": false,
        "description": "One coverage entry."
      },
      "minItems": 1,
      "description": "State automated and manual coverage."
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "record_kind",
    "standard",
    "issue",
    "source_url",
    "repository_language",
    "chat_language",
    "review_language",
    "checker",
    "full_automated_compliance_claim",
    "exclusions",
    "editorial_rules",
    "coverage"
  ],
  "additionalProperties": false,
  "description": "A data check does not prove language compliance."
}
