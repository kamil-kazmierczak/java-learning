    "closure_command": "kończymy",
    "carry_unfinished_work": true
  },
  "source_rules": [
    "Use official Java sources for technical facts."
  ],
  "evidence_rules": [
    "Record help and observed results."
  ],
  "approval_rules": [
    "Ask for approval of the lesson and related state changes."
  ]
