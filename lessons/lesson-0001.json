  "errors": [
    {
      "task_id": "task-01",
      "description": "The learner initially confused class loading with class initialization.",
      "correction": "A non-constant static field read triggers initialization when the declaring class is actively used."
    },
    {
      "task_id": "task-02",
      "description": "The learner initially expected a compile-time constant field read to initialize its declaring class.",
      "correction": "A compile-time constant can be inlined, so that field read does not require class initialization."
    },
    {
      "task_id": "task-09",
      "description": "The learner initially expected equal Class objects for the same binary name from different class loaders.",
      "correction": "Class identity includes the defining class loader, so the two Class objects represent different runtime types."
